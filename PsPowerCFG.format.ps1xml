<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>PsPowerCfg.PowerScheme</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerScheme</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Active</Label><Width>6</Width><Alignment>Center</Alignment></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Guid</Label><Width>36</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.IsActive) { '*' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Guid</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerSetting</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerSetting</TypeName>
      </ViewSelectedBy>
      <GroupBy>
        <ScriptBlock>if ($_.SubgroupAlias) { '{0} ({1})' -f $_.SubgroupName, $_.SubgroupAlias } else { $_.SubgroupName }</ScriptBlock>
        <Label>Subgroup</Label>
      </GroupBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label><Width>40</Width></TableColumnHeader>
          <TableColumnHeader><Label>Alias</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>AC</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>DC</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>Policy</Label><Width>6</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Alias</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.IsRange) { "$($_.AcValue) $($_.Units)".Trim() } elseif ($_.AcValueName) { "$($_.AcValue): $($_.AcValueName)" } else { $_.AcValue }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.IsRange) { "$($_.DcValue) $($_.Units)".Trim() } elseif ($_.DcValueName) { "$($_.DcValue): $($_.DcValueName)" } else { $_.DcValue }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.AcPolicyManaged -or $_.DcPolicyManaged) { 'GPO' }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerAlias</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerAlias</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Alias</Label><Width>44</Width></TableColumnHeader>
          <TableColumnHeader><Label>Kind</Label><Width>14</Width></TableColumnHeader>
          <TableColumnHeader><Label>Guid</Label><Width>36</Width></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Alias</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Guid</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerDevice</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerDevice</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Armed</Label><Width>6</Width></TableColumnHeader>
          <TableColumnHeader><Label>Programmable</Label><Width>13</Width></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><ScriptBlock>if ($_.WakeArmed) { "Yes" }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.WakeProgrammable) { "Yes" }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerWakeEvent</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerWakeEvent</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>WakeTime</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>SleepTime</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label><Width>7</Width></TableColumnHeader>
          <TableColumnHeader><Label>WakeSourceText</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>WakeTime</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>SleepTime</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WakeSourceType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WakeSourceText</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerCapabilities</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerCapabilities</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>StandbyS1</PropertyName></ListItem>
              <ListItem><PropertyName>StandbyS2</PropertyName></ListItem>
              <ListItem><PropertyName>StandbyS3</PropertyName></ListItem>
              <ListItem><PropertyName>StandbyS0LowPowerIdle</PropertyName></ListItem>
              <ListItem><PropertyName>S0NetworkConnected</PropertyName></ListItem>
              <ListItem><PropertyName>HibernateSupported</PropertyName></ListItem>
              <ListItem><PropertyName>HybridSleep</PropertyName></ListItem>
              <ListItem><PropertyName>FastStartup</PropertyName></ListItem>
              <ListItem><PropertyName>HiberFilePresent</PropertyName></ListItem>
              <ListItem><PropertyName>HiberFileType</PropertyName></ListItem>
              <ListItem><PropertyName>SoftOffS5</PropertyName></ListItem>
              <ListItem><PropertyName>LidPresent</PropertyName></ListItem>
              <ListItem><PropertyName>PowerButtonPresent</PropertyName></ListItem>
              <ListItem><PropertyName>SleepButtonPresent</PropertyName></ListItem>
              <ListItem><PropertyName>SystemBatteriesPresent</PropertyName></ListItem>
              <ListItem><PropertyName>UpsPresent</PropertyName></ListItem>
              <ListItem><PropertyName>WakeAlarmPresent</PropertyName></ListItem>
              <ListItem><PropertyName>RtcWake</PropertyName></ListItem>
              <ListItem><PropertyName>MinDeviceWakeState</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerRequest</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerRequest</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Type</Label><Width>16</Width></TableColumnHeader>
          <TableColumnHeader><Label>Caller</Label><Width>8</Width></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Reason</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CallerType</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Path) { $_.Path } else { $_.Name }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Reason</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerWakeTimer</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerWakeTimer</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Expires</Label><Width>22</Width></TableColumnHeader>
          <TableColumnHeader><Label>Owner</Label></TableColumnHeader>
          <TableColumnHeader><Label>Reason</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Expires</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Path) { $_.Path } elseif ($_.Owner) { $_.Owner } else { $_.Text }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>Reason</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>PsPowerCfg.PowerRequestOverride</Name>
      <ViewSelectedBy>
        <TypeName>PsPowerCfg.PowerRequestOverride</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>CallerType</Label><Width>10</Width></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label><Width>40</Width></TableColumnHeader>
          <TableColumnHeader><Label>Request</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>CallerType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.Request -join ', '</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
